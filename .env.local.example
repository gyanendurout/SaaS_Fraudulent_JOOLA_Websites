# Copy to .env.local and fill in. NEVER commit .env.local.

# ---- Supabase ----
# Browser-safe. Protected by RLS — read-only policies only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# SERVER ONLY. Bypasses RLS entirely. Never prefix with NEXT_PUBLIC_.
# Never reference from any file under app/ that is not a route handler or server action.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# ---- Claude (Phase 4: risk scoring + takedown narrative) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Crawl4AI service (Phase 2: rendering, screenshots, CertStream listener) ----
CRAWL_SERVICE_URL=http://localhost:11235
CRAWL_SERVICE_TOKEN=

# ---- Abuse-surface hardening for the public deployment ----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SCAN_RATE_LIMIT_PER_HOUR=10

# ---- Optional enrichment (all degrade gracefully if absent) ----
GOOGLE_SAFE_BROWSING_API_KEY=
URLSCAN_API_KEY=

# Postgres direct connection — migrations only, never used by the Next.js runtime.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
